[resource]
script = ExtResource("1_catalog")
plant_variants = Array[ExtResource("2_variant")]([SubResource("PlantVariant_base_common"), SubResource("PlantVariant_leaf_cap"), SubResource("PlantVariant_moss_cushion"), SubResource("PlantVariant_moonbell"), SubResource("PlantVariant_blush_color"), SubResource("PlantVariant_tiny_gardener"), SubResource("PlantVariant_sunpatch"), SubResource("PlantVariant_rainbell"), SubResource("PlantVariant_fern_curl"), SubResource("PlantVariant_glow_pod")])
jars = Array[ExtResource("3_jar")]([SubResource("Jar_default_glass"), SubResource("Jar_moss_glass")])
environments = Array[ExtResource("4_environment")]([SubResource("Environment_forest"), SubResource("Environment_indoor_window"), SubResource("Environment_rainforest")])
