glass_border_color = Color(0.89, 0.98, 1, 0.82)
evaporation_modifier = 1.0
spawn_modifier = 1.0
reproduction_modifier = 1.0

[sub_resource type="Resource" id="Jar_moss_glass"]
script = ExtResource("3_jar")
id = &"moss_glass"
display_name = "Moss-Tinted Jar"
description = "Prototype/TBD alternative jar for testing capacity and environment modifiers."
