[sub_resource type="Resource" id="Jar_default_glass"]
script = ExtResource("3_jar")
id = &"default_glass"
display_name = "Clear Glass Jar"
description = "Prototype/TBD default jar with neutral modifiers."
price = 0
capacity = 12
