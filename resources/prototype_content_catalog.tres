[gd_resource type="Resource" script_class="ContentCatalog" load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/content_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/plant_variant_definition.gd" id="2_variant"]
[ext_resource type="Script" path="res://scripts/jar_definition.gd" id="3_jar"]
[ext_resource type="Script" path="res://scripts/environment_definition.gd" id="4_environment"]

[sub_resource type="Resource" id="PlantVariant_base_common"]
script = ExtResource("2_variant")
id = &"base_common"
display_name = "Common Blob"
description = "Prototype/TBD: the familiar soft white dumpling-like plant."
rarity = &"common"
body_color = Color(0.985, 0.985, 0.97, 1)
head_accessory = &"none"
equipment = &"none"
mutation_weight = 0.0
reproduction_difficulty = 1.0
adult_sell_value = 4
young_buy_price = 6

[sub_resource type="Resource" id="PlantVariant_blush_color"]
script = ExtResource("2_variant")
id = &"blush_color"
display_name = "Blush Blob"
description = "Prototype/TBD color mutation used to test an immediately visible discovery."
