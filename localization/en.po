msgid "PLANT_BASE_COMMON_NAME"
msgstr "Common Blob"

msgid "PLANT_BASE_COMMON_DESCRIPTION"
msgstr "A soft white dumpling friend with a calm little smile."

msgid "PLANT_BASE_COMMON_HINT"
msgstr "A patient little presence can appear almost anywhere."

msgid "PLANT_BASE_COMMON_RECIPE"
msgstr "Any place • Any moisture • Any light • Base result when no recipe matches"

msgid "PLANT_LEAF_CAP_NAME"
msgstr "Leaf-Cap"

msgid "PLANT_LEAF_CAP_DESCRIPTION"
msgstr "A pear-shaped forest blob wearing a fresh leaf cap."

msgid "PLANT_LEAF_CAP_HINT"
msgstr "In a bright forest, keep the soil softly moist."

msgid "PLANT_LEAF_CAP_RECIPE"
msgstr "Forest • Moist • Day • Natural spawn or reproduction"

msgid "PLANT_MOSS_CUSHION_NAME"
msgstr "Moss Cushion"

msgid "PLANT_MOSS_CUSHION_DESCRIPTION"
msgstr "A low, velvety cushion that looks happiest after rain."

msgid "PLANT_MOSS_CUSHION_HINT"
msgstr "A balanced forest day and generous water invite a soft carpet."

msgid "PLANT_MOSS_CUSHION_RECIPE"
msgstr "Forest • Wet • Balanced light • Natural spawn"

msgid "PLANT_MOONBELL_NAME"
msgstr "Moonbell"

msgid "PLANT_MOONBELL_DESCRIPTION"
msgstr "A silver-lilac bell shape that listens to moonlight."

msgid "PLANT_MOONBELL_HINT"
msgstr "Let two forest friends meet where moonlight outlasts the sun."

msgid "PLANT_MOONBELL_RECIPE"
msgstr "Forest • Moist • Night • Reproduction"

msgid "PLANT_BLUSH_COLOR_NAME"
msgstr "Blush Blob"

msgid "PLANT_BLUSH_COLOR_DESCRIPTION"
msgstr "A round coral-pink blob warmed by the window."

msgid "PLANT_BLUSH_COLOR_HINT"
msgstr "A sunny window and gentle moisture bring out a rosy glow."

msgid "PLANT_BLUSH_COLOR_RECIPE"
msgstr "Window Nook • Moist • Day • Natural spawn or reproduction"

msgid "PLANT_TINY_GARDENER_NAME"
msgstr "Tiny Gardener"

msgid "PLANT_TINY_GARDENER_DESCRIPTION"
msgstr "A squat helper with a sun hat and a very small watering can."

msgid "PLANT_TINY_GARDENER_HINT"
msgstr "A Common friend and a Blush friend may share a balanced window secret."

msgid "PLANT_TINY_GARDENER_RECIPE"
msgstr "Window Nook • Moist • Balanced light • Reproduction • Common + Blush parents"

msgid "PLANT_SUNPATCH_NAME"
msgstr "Sunpatch"

msgid "PLANT_SUNPATCH_DESCRIPTION"
msgstr "A tall golden bean that stores warm window light."

msgid "PLANT_SUNPATCH_HINT"
msgstr "Leave a bright window patch a little dry and see who reaches upward."

msgid "PLANT_SUNPATCH_RECIPE"
msgstr "Window Nook • Dry • Day • Natural spawn"

msgid "PLANT_RAINBELL_NAME"
msgstr "Rainbell"

msgid "PLANT_RAINBELL_DESCRIPTION"
msgstr "A clear blue bell-drop that feels at home below the waterline."

msgid "PLANT_RAINBELL_HINT"
msgstr "Deep rainforest water may ring a quiet blue bell."

msgid "PLANT_RAINBELL_RECIPE"
msgstr "Rainforest • Submerged • Any light • Natural spawn or reproduction"

msgid "PLANT_FERN_CURL_NAME"
msgstr "Fern Curl"

msgid "PLANT_FERN_CURL_DESCRIPTION"
msgstr "A lively green spiral unfurling toward rainforest daylight."

msgid "PLANT_FERN_CURL_HINT"
msgstr "Two rain-soaked friends may curl together beneath the daytime canopy."

msgid "PLANT_FERN_CURL_RECIPE"
msgstr "Rainforest • Wet • Day • Reproduction"

msgid "PLANT_GLOW_POD_NAME"
msgstr "Glow Pod"

msgid "PLANT_GLOW_POD_DESCRIPTION"
msgstr "A tall teal pod whose freckles glow under the rainforest moon."

msgid "PLANT_GLOW_POD_HINT"
msgstr "Keep the rainforest wet until night gathers into tiny lights."

msgid "PLANT_GLOW_POD_RECIPE"
msgstr "Rainforest • Wet • Night • Natural spawn"

msgid "JAR_DEFAULT_GLASS_NAME"
msgstr "Clear Glass Jar"

msgid "JAR_DEFAULT_GLASS_DESCRIPTION"
msgstr "A clear, roomy home with neutral ecology modifiers."

msgid "JAR_MOSS_GLASS_NAME"
msgstr "Moss-Tinted Jar"

msgid "JAR_MOSS_GLASS_DESCRIPTION"
